    {
      "name" : "memory_search",
      "title" : "Silkweb: Search Memory",
      "description" : "Searches documents in this grant’s read folders by text, type, status and creation date. Returns at most 50 results (fewer if the grant’s max_results is lower) and an index status that says when results may be incomplete.",
      "inputSchema" : {
        "type" : "object",
        "properties" : {
          "query" : {
            "type" : "string",
            "description" : "Words that must all appear in the title or body, ignoring case and diacritics. Empty matches every document that passes the filters."
          },
          "project" : {
            "type" : "string",
            "description" : "This grant’s project, or its agent_folder."
          },
          "type" : {
            "type" : "array",
            "description" : "Only documents of these types.",
            "items" : {
              "type" : "string",
              "description" : "Front matter type.",
              "enum" : [
                "memory",
                "decision",
                "progress",
                "handoff"
              ]
            }
          },
          "status" : {
            "type" : "array",
            "description" : "Only these statuses, ignoring case.",
            "items" : {
              "type" : "string",
              "description" : "Front matter status."
            }
          },
          "createdAfter" : {
            "type" : "string",
            "description" : "Inclusive. A date such as 2026-10-07 (midnight UTC) or an ISO 8601 time."
          },
          "createdBefore" : {
            "type" : "string",
            "description" : "Exclusive. A date such as 2026-10-08 (midnight UTC) or an ISO 8601 time."
          },
          "limit" : {
            "type" : "integer",
            "description" : "Most results to return. Default 10.",
            "minimum" : 1,
            "maximum" : 50
          },
          "mode" : {
            "type" : "string",
            "description" : "default (all words, as above) or ranked: orders by relevance, adds score to each result, and reads \"phrases\", tag:, type:, status:, project:, after: and before: in query.",
            "enum" : [
              "default",
              "ranked"
            ]
          },
          "includeArchived" : {
            "type" : "boolean",
            "description" : "Also return archived documents (in a project's Archive folder). Default false."
          },
          "recentDays" : {
            "type" : "integer",
            "description" : "Progress and handoffs older than this many days are left out, unless a project has none newer. Default 30. 0 turns this off, and so do createdAfter and createdBefore.",
            "minimum" : 0,
            "maximum" : 3650
          }
        },
        "additionalProperties" : false
      },
      "outputSchema" : {
        "type" : "object",
        "properties" : {
          "results" : {
            "type" : "array",
            "items" : {
              "type" : "object",
              "properties" : {
                "title" : {
                  "type" : "string"
                },
                "path" : {
                  "type" : "string"
                },
                "documentId" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "memoryId" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "revision" : {
                  "type" : "string"
                },
                "type" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "project" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "status" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "agent" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "session" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "createdAt" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "modified" : {
                  "type" : "string"
                },
                "review" : {
                  "type" : "string",
                  "enum" : [
                    "reviewed",
                    "unreviewed",
                    "reviewed-earlier-revision"
                  ]
                },
                "pinned" : {
                  "type" : "boolean"
                },
                "reviewAfter" : {
                  "type" : [
                    "string",
                    "null"
                  ]
                },
                "reviewDue" : {
                  "type" : "boolean"
                },
                "archived" : {
                  "type" : "boolean"
                },
                "supersededBy" : {
                  "type" : "array",
                  "items" : {
                    "type" : "object",
                    "properties" : {
                      "memoryId" : {
                        "type" : "string"
                      },
                      "state" : {
                        "type" : "string",
                        "enum" : [
                          "claimed",
                          "accepted",
                          "declined"
                        ]
                      }
                    }
                  }
                },
                "matchKind" : {
                  "type" : "string",
                  "enum" : [
                    "title",
                    "body"
                  ]
                },
                "excerpt" : {
                  "type" : "string"
                },
                "score" : {
                  "type" : "number"
                }
              }
            }
          },
          "total" : {
            "type" : "integer"
          },
          "index" : {
