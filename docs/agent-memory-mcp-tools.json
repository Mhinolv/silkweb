    {
      "name" : "memory_propose_change",
      "title" : "Silkweb: Propose an Edit",
      "description" : "Proposes a new body (the text after the front matter) for a document in this grant’s read folders, including the owner’s, for the owner to review in Silkweb. Nothing in the Library changes: only the owner applies or rejects it. Needs expectedRevision from memory_read and a short reason. Use it when memory_update answers update_requires_proposal. Retrying with the same idempotencyKey returns the original result.",
      "inputSchema" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string",
            "description" : "Library-relative path of a document in a read folder, such as Memory/Projects/Silkweb/Memories/Use flock.md. Or documentId."
          },
          "documentId" : {
            "type" : "string",
            "description" : "The documentId from a search or read result, instead of path."
          },
          "expectedRevision" : {
            "type" : "string",
