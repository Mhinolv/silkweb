              "max_read_bytes" : {
                "type" : "integer"
              },
              "max_results" : {
                "type" : "integer"
              },
              "requests_per_minute" : {
                "type" : "integer"
              }
            }
          },
          "operations" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "profile" : {
            "type" : "string"
          },
          "project" : {
            "type" : "string"
