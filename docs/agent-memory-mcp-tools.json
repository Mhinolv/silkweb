                "memoryIds" : {
                  "type" : "array",
                  "items" : {
                    "type" : "string"
                  }
                },
                "related" : {
                  "type" : "array",
                  "items" : {
                    "type" : "string"
                  }
                },
                "message" : {
                  "type" : "string"
                }
              }
            }
          },
          "error" : {
            "type" : "object",
            "properties" : {
              "code" : {
                "type" : "string"
              },
              "message" : {
                "type" : "string"
              },
              "retryAfter" : {
                "type" : "integer"
              },
              "currentRevision" : {
                "type" : "string"
              },
              "title" : {
                "type" : "string"
              }
            }
          }
