    {
      "name" : "memory_create",
      "title" : "Silkweb: Create Document",
      "description" : "Creates a new Markdown document in Memories, Progress or Handoffs. Never replaces or edits an existing document; if the name is taken, a numbered name is used. The document, front matter included, may be at most the grant’s max_create_bytes (256 KB unless the owner changed it). Retrying with the same idempotencyKey returns the original result instead of a second document.",
      "inputSchema" : {
        "type" : "object",
        "properties" : {
          "folder" : {
            "type" : "string",
            "description" : "Entry folder. Also picks the default type: memory, progress or handoff. agent-memories is the agent folder’s Memories (agent_create_root), for memory and decision only.",
            "enum" : [
              "memories",
              "progress",
              "handoffs",
              "agent-memories"
            ]
          },
          "type" : {
            "type" : "string",
            "description" : "Front matter type. memory and decision go in Memories.",
            "enum" : [
              "memory",
              "decision",
              "progress",
              "handoff"
            ]
          },
          "folderPath" : {
            "type" : "string",
            "description" : "Instead of folder: a Library-relative folder inside a create folder (create_roots), such as Memory/Projects/Silkweb/Progress/Sprint 1. Needs type. progress goes only in a project’s Progress and handoff only in its Handoffs."
          },
          "title" : {
            "type" : "string",
            "description" : "Sentence case, without “:” or “/”. Becomes the file name."
          },
          "body" : {
            "type" : "string",
            "description" : "Markdown text. A body that doesn’t start with “# <title>” gets that heading."
          },
          "idempotencyKey" : {
            "type" : "string",
            "description" : "Request key, 1 to 200 characters. Reuse it when retrying; without one, every call creates a new document.",
            "minLength" : 1,
            "maxLength" : 200
          },
          "session" : {
            "type" : "string",
            "description" : "Session recorded in the front matter. Defaults to this server’s session."
          },
          "status" : {
            "type" : "string",
            "description" : "Front matter status, such as in-progress."
          },
          "observedAt" : {
            "type" : "string",
            "description" : "When this was observed, as an ISO 8601 UTC time."
          },
          "reviewAfter" : {
            "type" : "string",
            "description" : "When to review this again, as an ISO 8601 UTC time."
          },
          "supersedes" : {
            "type" : "array",
            "description" : "memory_id values this document replaces in meaning. Those documents are kept.",
            "items" : {
              "type" : "string",
              "description" : "A memory_id."
            }
          }
        },
        "required" : [
          "title",
          "body"
        ],
        "additionalProperties" : false
      },
      "outputSchema" : {
        "type" : "object",
        "properties" : {
          "outcome" : {
            "type" : "string",
            "enum" : [
              "created",
              "duplicate",
              "reconciled",
              "abandoned",
              "refused"
            ]
          },
          "path" : {
            "type" : [
              "string",
              "null"
            ]
          },
          "receipt" : {
            "type" : "object"
          },
          "replayed" : {
            "type" : "boolean"
          },
          "error" : {
            "type" : "object",
            "properties" : {
              "code" : {
                "type" : "string"
              },
              "message" : {
                "type" : "string"
              },
              "retryAfter" : {
                "type" : "integer"
              },
              "currentRevision" : {
                "type" : "string"
              },
              "title" : {
                "type" : "string"
              }
            }
          }
        }
      },
      "annotations" : {
        "title" : "Silkweb: Create Document",
        "readOnlyHint" : false,
        "destructiveHint" : false,
        "idempotentHint" : true,
        "openWorldHint" : false
      }
    },
