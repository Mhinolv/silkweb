    {
      "name" : "memory_update",
      "title" : "Silkweb: Update Document",
      "description" : "Replaces the body (the text after the front matter) of a document an agent created in Memories, Progress or Handoffs. Needs expectedRevision, the revision from memory_read: if the document changed since, nothing is written and the error carries currentRevision. Documents the owner wrote or edited are refused with update_requires_proposal, and a document with unsaved changes in Silkweb with document_has_unsaved_changes (try again later). The earlier text is kept. Retrying with the same idempotencyKey returns the original result.",
      "inputSchema" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string",
            "description" : "Library-relative path of a document in a create folder, such as Memory/Projects/Silkweb/Handoffs/Next steps.md. Or documentId."
          },
          "documentId" : {
            "type" : "string",
            "description" : "The documentId from a search or read result, instead of path."
          },
          "expectedRevision" : {
            "type" : "string",
            "description" : "The revision from memory_read. If the document changed since, nothing is written."
          },
          "body" : {
            "type" : "string",
            "description" : "The new Markdown text after the front matter, replacing all of it. The front matter stays as it is."
          },
          "idempotencyKey" : {
            "type" : "string",
            "description" : "Request key, 1 to 200 characters. Reuse it when retrying.",
            "minLength" : 1,
            "maxLength" : 200
          },
          "session" : {
            "type" : "string",
            "description" : "Session recorded in the receipt. Defaults to this server’s session."
          }
        },
        "required" : [
          "expectedRevision",
          "body"
        ],
        "additionalProperties" : false
